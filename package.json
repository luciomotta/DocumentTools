{
  "name": "document-tools",
  "version": "2.0.0",
  "type": "module",
  "description": "Ferramenta unificada para manipulação de documentos PDF e Office em SvelteKit",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "start": "vite dev --host"
  },
  "keywords": [
    "pdf",
    "office",
    "excel",
    "merger",
    "converter",
    "html2pdf",
    "document",
    "tools"
  ],
  "author": "Document Tools Team",
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/adapter-auto": "^5.0.0",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@quicktoolsone/pdf-compress": "^2.0.0",
    "html2pdf.js": "^0.10.1",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  }
}
